#!/bin/sh
# abnehm-app managed hook
set -eu

if [ "${ABNEHM_APP_ALLOW_PRIMARY_WRITE:-}" = "I_KNOW_WHAT_I_AM_DOING" ]; then
  cat >/dev/null
  exit 0
fi

blocked=0
while read -r local_ref local_sha remote_ref remote_sha; do
  if [ "$remote_ref" = "refs/heads/main" ]; then
    echo "ABGEBROCHEN: Direkte Pushes auf main sind gesperrt." >&2
    echo "Pushe den Ticket-Branch und führe ihn per Pull Request zusammen." >&2
    blocked=1
  fi
done

[ "$blocked" -eq 0 ]

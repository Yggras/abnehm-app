#!/usr/bin/env bash
# Secrets des Produktivbetriebs (compose.prod.yaml, #115). Ablauf: docs/betrieb.md › „Secrets“.
#   scripts/prod-secrets                      # fehlende Zufalls-Secrets anlegen, dann prüfen
#   scripts/prod-secrets setzen <name>        # einen Wert aus dem Passwortmanager einlesen (stdin, ohne Echo)
#   scripts/prod-secrets pruefen              # nur prüfen: vollständig, nicht leer, Rechte 0700/0600
#
# Die Dateien liegen außerhalb jedes Checkouts in ABNEHM_PROD_SECRETS_DIR (Standard:
# ~/Library/Application Support/abnehm-app/produktion/secrets) und damit weder in Git, im Build-Kontext
# noch im Image. Werte gibt das Skript nie aus. Wiederherstellungsquelle ist der Passwortmanager (#22).
set -euo pipefail

# shellcheck source=prod-umgebung
source "$(dirname "${BASH_SOURCE[0]}")/prod-umgebung"
secrets_dir="$prod_secrets_dir"
generated=(postgres_password better_auth_secret invite_code_secret)
provided=(anthropic_api_key)
all=("${generated[@]}" "${provided[@]}")

usage() {
  sed -n '2,5p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//' >&2
  exit 2
}

mode_of() { stat -f '%Lp' "$1"; }

check() {
  local problems=0 name file
  if [[ ! -d "$secrets_dir" ]]; then
    echo "FEHLT: Verzeichnis $secrets_dir (scripts/prod-secrets legt es an)" >&2
    return 1
  fi
  if [[ "$(mode_of "$secrets_dir")" != "700" ]]; then
    echo "RECHTE: $secrets_dir hat $(mode_of "$secrets_dir"), erwartet 700" >&2
    problems=1
  fi
  if git -C "$secrets_dir" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    echo "ORT: $secrets_dir liegt in einem Git-Checkout; Secrets gehören außerhalb" >&2
    problems=1
  fi
  for name in "${all[@]}"; do
    file="$secrets_dir/$name"
    if [[ ! -s "$file" ]]; then
      echo "FEHLT: $name" >&2
      problems=1
    elif [[ "$(mode_of "$file")" != "600" ]]; then
      echo "RECHTE: $name hat $(mode_of "$file"), erwartet 600" >&2
      problems=1
    fi
  done
  if [[ "$problems" == 0 ]]; then echo "Secrets vollständig: $secrets_dir"; fi
  return "$problems"
}

write_secret() {
  local name="$1" value="$2"
  mkdir -p "$secrets_dir"
  chmod 700 "$secrets_dir"
  (umask 077 && printf '%s\n' "$value" >"$secrets_dir/$name.neu")
  mv "$secrets_dir/$name.neu" "$secrets_dir/$name"
  chmod 600 "$secrets_dir/$name"
}

case "${1:-anlegen}" in
  anlegen)
    created=()
    for name in "${generated[@]}"; do
      if [[ ! -s "$secrets_dir/$name" ]]; then
        write_secret "$name" "$(openssl rand -hex 32)"
        created+=("$name")
      fi
    done
    if [[ ${#created[@]} -gt 0 ]]; then
      echo "Neu angelegt: ${created[*]}"
      echo "Jetzt jeden Wert in den Passwortmanager übernehmen, etwa mit:"
      for name in "${created[@]}"; do echo "  pbcopy < \"$secrets_dir/$name\""; done
      echo "Danach die Zwischenablage leeren: pbcopy < /dev/null"
    fi
    if [[ ! -s "$secrets_dir/anthropic_api_key" ]]; then
      echo "Den API-Schlüssel der Fotoanalyse aus dem Passwortmanager einlesen: scripts/prod-secrets setzen anthropic_api_key"
    fi
    check
    ;;
  setzen)
    name="${2:-}"
    [[ " ${all[*]} " == *" $name "* ]] || { echo "Unbekanntes Secret: ${name:-<leer>} (erlaubt: ${all[*]})" >&2; exit 2; }
    if [[ "$name" == postgres_password && -s "$secrets_dir/$name" ]]; then
      echo "Hinweis: Postgres übernimmt ein neues Passwort nicht von selbst, wenn das Volume schon existiert (docs/betrieb.md)." >&2
    fi
    if [[ -t 0 ]]; then
      read -r -s -p "Wert für $name (Eingabe unsichtbar): " value
      echo >&2
    else
      IFS= read -r value
    fi
    [[ -n "$value" ]] || { echo "Leerer Wert, nichts geschrieben." >&2; exit 1; }
    write_secret "$name" "$value"
    echo "Gespeichert: $name"
    ;;
  pruefen) check ;;
  *) usage ;;
esac

#!/bin/sh
# Hermetischer Test für scripts/geraete-slot: xcrun, adb und docker sind gemockt und protokollieren ihre Aufrufe.
set -eu
root=$(CDPATH= cd -- "$(dirname "$0")/.." && pwd)
slot="$root/scripts/geraete-slot"
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT HUP INT TERM
mkdir -p "$tmp/bin" "$tmp/main"
git -C "$tmp/main" init -q
git -C "$tmp/main" -c user.name=Test -c user.email=test@example.com commit --allow-empty -qm initial
git -C "$tmp/main" worktree add -qb work/900001-test "$tmp/work"
git -C "$tmp/main" worktree add -qb work/900002-test "$tmp/work2"
main=$(git -C "$tmp/main" rev-parse --show-toplevel)
work=$(git -C "$tmp/work" rev-parse --show-toplevel)
state="$(git -C "$tmp/main" rev-parse --path-format=absolute --git-common-dir)/abnehm-app-geraete-slot"
for tool in xcrun docker; do
  printf '#!/bin/sh\necho "%s $*" >> "%s/calls"\n' "$tool" "$tmp" > "$tmp/bin/$tool"
done
printf '%s\n' '#!/bin/sh' \
  "echo \"adb \$*\" >> \"$tmp/calls\"" \
  '[ "$1" = devices ] && printf "List of devices attached\nemulator-5554\tdevice\nR58W123\tdevice\n"' \
  'exit 0' > "$tmp/bin/adb"
chmod +x "$tmp/bin/"*
unset ABNEHM_GERAETE_SLOT
export PATH="$tmp/bin:$PATH" ABNEHM_GERAETE_SLOT_INTERVALL=1 ABNEHM_GERAETE_SLOT_NACHFRIST_SEKUNDEN=0
fail() { echo "FEHLER: $*" >&2; exit 1; }
in_dir() { dir=$1; shift; (cd "$dir" && "$slot" "$@"); }
cleaned() { grep -Fx 'xcrun simctl shutdown all' "$tmp/calls" >/dev/null 2>&1; }
# hold <dir>: hält die Sperre im Hintergrund, bis $tmp/go existiert; setzt holder_pid.
hold() {
  rm -f "$tmp/go" "$tmp/held"
  (cd "$1" && exec "$slot" mit -- sh -c "touch '$tmp/held'; while [ ! -f '$tmp/go' ]; do sleep 0.1; done") 2>/dev/null &
  holder_pid=$!
  while [ ! -f "$tmp/held" ]; do sleep 0.1; done
}

# Erstes Nehmen räumt Geräte und E2E-Backend auf; nach dem Befehl ist die Sperre frei.
[ "$(in_dir "$tmp/main" mit -- echo lauf 2>/dev/null)" = lauf ] || fail 'Befehl nicht ausgeführt'
cleaned || fail 'Simulatoren nicht heruntergefahren'
grep -Fx 'adb -s emulator-5554 emu kill' "$tmp/calls" >/dev/null || fail 'Emulator nicht beendet'
grep -F 'R58W123 emu' "$tmp/calls" >/dev/null && fail 'echtes Gerät beendet'
grep -Fx 'docker compose --project-name abnehm-e2e down --volumes --remove-orphans' "$tmp/calls" >/dev/null || fail 'E2E-Backend nicht entfernt'
[ "$(in_dir "$tmp/work" status)" = "frei (zuletzt: $main)" ] || fail "nach dem Befehl nicht frei: $(in_dir "$tmp/work" status)"

# Derselbe Worktree findet seine Geräte wieder vor; Exit-Code des Befehls kommt durch.
: > "$tmp/calls"
status=0; in_dir "$tmp/main" mit -- sh -c 'exit 7' 2>/dev/null || status=$?
[ "$status" = 7 ] || fail "Exit-Code $status statt 7"
cleaned && fail 'gleicher Worktree hat aufgeräumt'

# Während der Befehl läuft, wartet eine andere Session; danach räumt sie auf, weil der Worktree wechselt.
hold "$tmp/main"
in_dir "$tmp/work" status | grep -F "belegt: $main" >/dev/null || fail 'status belegt'
(cd "$tmp/work" && "$slot" mit -- echo zweiter > "$tmp/warten" 2>"$tmp/err") &
waiter=$!
sleep 2
[ -s "$tmp/warten" ] && fail 'nicht gewartet'
grep -F "belegt: $main" "$tmp/err" >/dev/null || fail 'Inhaber beim Warten nicht genannt'
: > "$tmp/calls"
touch "$tmp/go"
wait "$holder_pid"
wait "$waiter" || fail 'warten fehlgeschlagen'
[ "$(cat "$tmp/warten")" = zweiter ] || fail 'wartender Befehl nicht ausgeführt'
cleaned || fail 'Wechsel des Worktrees ohne Aufräumen'
grep -F "Zuletzt nutzte $main" "$tmp/err" >/dev/null || fail 'Hinweis auf Neuinstallation fehlt'

# Verschachtelt: ein Befehl unter der Sperre nimmt sie ohne Warten erneut.
[ "$(in_dir "$tmp/work" mit -- "$slot" mit -- echo innen 2>/dev/null)" = innen ] || fail 'verschachtelter Aufruf'

# Nachfrist: Nach dem Befehl hat derselbe Worktree Vorrang, ein anderer wartet.
ABNEHM_GERAETE_SLOT_NACHFRIST_SEKUNDEN=60 in_dir "$tmp/work" mit -- true 2>/dev/null
in_dir "$tmp/main" status | grep -F "Nachfrist: $work hat noch" >/dev/null || fail "status Nachfrist: $(in_dir "$tmp/main" status)"
(cd "$tmp/main" && exec "$slot" mit -- touch "$tmp/vorbei") 2>/dev/null &
waiter=$!
sleep 2
[ -f "$tmp/vorbei" ] && fail 'Nachfrist nicht beachtet'
kill "$waiter"; wait "$waiter" 2>/dev/null || true
: > "$tmp/calls"
in_dir "$tmp/work" mit -- true 2>/dev/null || fail 'eigener Worktree in der Nachfrist'
cleaned && fail 'Nachfrist des eigenen Worktrees hat aufgeräumt'
# Fehlt der Worktree des letzten Inhabers, gilt seine Nachfrist nicht.
printf 'zuletzt=%s/fehlt\nfrei_ab=%s\n' "$tmp" "$(( $(date +%s) + 60 ))" > "$state"
in_dir "$tmp/main" mit -- true 2>/dev/null || fail 'Nachfrist ohne Worktree'

# Absturz: Stirbt der Prozess von `mit`, übernimmt die nächste Session sofort.
hold "$tmp/main"
pkill -P "$holder_pid" 2>/dev/null || true
kill -9 "$holder_pid"
wait "$holder_pid" 2>/dev/null || true
in_dir "$tmp/work" status | grep -F 'verwaist: Prozess' >/dev/null || fail 'Absturz nicht als verwaist erkannt'
in_dir "$tmp/work" mit -- true 2>"$tmp/err" || fail 'verwaiste Sperre nicht übernommen'
grep -F 'verwaist' "$tmp/err" >/dev/null || fail 'Übernahme nicht gemeldet'

# Sperre der Vorgängerversion (Inhaber = Worktree): gilt bis zur Frist, danach verwaist.
printf 'inhaber=%s\nseit=%s\nerneuert=%s\n' "$work" "$(date +%s)" "$(date +%s)" > "$state"
in_dir "$tmp/main" status | grep -F "belegt: $work" >/dev/null || fail 'alte Sperre nicht beachtet'
ABNEHM_GERAETE_SLOT_MINUTEN=0 in_dir "$tmp/main" mit -- true 2>/dev/null || fail 'abgelaufene alte Sperre nicht übernommen'

# `nehmen` gibt es nicht mehr.
status=0; in_dir "$tmp/main" nehmen 2>/dev/null || status=$?
[ "$status" = 2 ] || fail "nehmen: Exit $status statt 2"

# Notfall: erzwungene Freigabe einer fremden Sperre.
hold "$tmp/main"
in_dir "$tmp/work" freigeben --erzwingen 2>/dev/null
case "$(in_dir "$tmp/work" status)" in frei*) ;; *) fail 'erzwungene Freigabe' ;; esac
touch "$tmp/go"
wait "$holder_pid"
case "$(in_dir "$tmp/work" status)" in frei*) ;; *) fail 'Ende des alten Inhabers hat die Sperre verändert' ;; esac
printf 'geraete-slot: OK\n'

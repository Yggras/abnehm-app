#!/bin/sh
# Hermetischer Test für scripts/geraete-slot: xcrun, adb und docker sind gemockt und protokollieren ihre Aufrufe.
set -eu
root=$(CDPATH= cd -- "$(dirname "$0")/.." && pwd)
slot="$root/scripts/geraete-slot"
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT HUP INT TERM
mkdir -p "$tmp/bin" "$tmp/main"
git -C "$tmp/main" init -q
git -C "$tmp/main" -c user.name=Test -c user.email=test@example.com commit --allow-empty -qm initial
git -C "$tmp/main" worktree add -qb work/900001-test "$tmp/work"
git -C "$tmp/main" worktree add -qb work/900002-test "$tmp/work2"
main=$(git -C "$tmp/main" rev-parse --show-toplevel)
for tool in xcrun docker; do
  printf '#!/bin/sh\necho "%s $*" >> "%s/calls"\n' "$tool" "$tmp" > "$tmp/bin/$tool"
done
printf '%s\n' '#!/bin/sh' \
  "echo \"adb \$*\" >> \"$tmp/calls\"" \
  '[ "$1" = devices ] && printf "List of devices attached\nemulator-5554\tdevice\nR58W123\tdevice\n"' \
  'exit 0' > "$tmp/bin/adb"
chmod +x "$tmp/bin/"*
export PATH="$tmp/bin:$PATH" ABNEHM_GERAETE_SLOT_INTERVALL=1
fail() { echo "FEHLER: $*" >&2; exit 1; }
in_dir() { dir=$1; shift; (cd "$dir" && "$slot" "$@"); }

# Neu nehmen räumt Geräte und E2E-Backend auf; der Inhaber erneuert ohne Aufräumen.
[ "$(in_dir "$tmp/main" nehmen 2>/dev/null)" = genommen ] || fail 'nehmen auf freier Sperre'
grep -Fx 'xcrun simctl shutdown all' "$tmp/calls" >/dev/null || fail 'Simulatoren nicht heruntergefahren'
grep -Fx 'adb -s emulator-5554 emu kill' "$tmp/calls" >/dev/null || fail 'Emulator nicht beendet'
grep -F 'R58W123 emu' "$tmp/calls" >/dev/null && fail 'echtes Gerät beendet'
grep -Fx 'docker compose --project-name abnehm-e2e down --volumes --remove-orphans' "$tmp/calls" >/dev/null || fail 'E2E-Backend nicht entfernt'
: > "$tmp/calls"
[ "$(in_dir "$tmp/main" nehmen 2>/dev/null)" = erneuert ] || fail 'erneuern'
[ ! -s "$tmp/calls" ] || fail 'Erneuern hat aufgeräumt'

# Eine andere Session wartet (Exit 3) und darf nicht freigeben.
status=0; in_dir "$tmp/work" nehmen > /dev/null 2> "$tmp/err" || status=$?
[ "$status" = 3 ] || fail "belegt: Exit $status statt 3"
grep -F "$main" "$tmp/err" >/dev/null || fail 'Inhaber nicht genannt'
in_dir "$tmp/work" status | grep -F "belegt: $main" >/dev/null || fail 'status belegt'
in_dir "$tmp/work" freigeben 2>/dev/null && fail 'fremde Sperre freigegeben'

# Freigeben räumt auf und löst die Sperre.
: > "$tmp/calls"
in_dir "$tmp/main" freigeben 2>/dev/null
grep -Fx 'xcrun simctl shutdown all' "$tmp/calls" >/dev/null || fail 'Freigeben ohne Aufräumen'
[ "$(in_dir "$tmp/work" status)" = frei ] || fail 'nach Freigeben nicht frei'

# Verwaist nach Ablauf der Frist.
[ "$(in_dir "$tmp/work" nehmen 2>/dev/null)" = genommen ] || fail 'nehmen nach Freigabe'
[ "$(ABNEHM_GERAETE_SLOT_MINUTEN=0 in_dir "$tmp/main" nehmen 2>/dev/null)" = genommen ] || fail 'abgelaufene Sperre nicht übernommen'

# Verwaist, weil der Worktree des Inhabers fehlt.
in_dir "$tmp/main" freigeben 2>/dev/null
in_dir "$tmp/work" nehmen > /dev/null 2>&1
rm -rf "$tmp/work"
[ "$(in_dir "$tmp/main" nehmen 2>/dev/null)" = genommen ] || fail 'Sperre ohne Worktree nicht übernommen'

# --warten nimmt die Sperre, sobald der Inhaber sie freigibt.
(cd "$tmp/work2" && "$slot" nehmen --warten > "$tmp/warten" 2>/dev/null) &
waiter=$!
sleep 2
in_dir "$tmp/main" freigeben 2>/dev/null
wait "$waiter" || fail 'warten fehlgeschlagen'
[ "$(cat "$tmp/warten")" = genommen ] || fail 'warten hat nicht genommen'

# Notfall: erzwungene Freigabe einer fremden Sperre.
in_dir "$tmp/main" freigeben --erzwingen 2>/dev/null
[ "$(in_dir "$tmp/main" status)" = frei ] || fail 'erzwungene Freigabe'
printf 'geraete-slot: OK\n'

#!/bin/sh
set -eu

# Startet je Ticket eine eigenständige Claude-Code- oder Pi-Session in einem
# Herdr-Tab. Jede Session beginnt im primären Checkout mit dem Skill `start`;
# der Skill `start` claimt das Ticket und legt den Worktree an. Claude wechselt
# hinein; Pi arbeitet anschließend per absoluten Pfaden und `cd` darin.
# Herdr-Mechanik wie bei Firstmate (`tab create` + `pane run`):
# https://github.com/kunchenguid/firstmate/blob/main/bin/backends/herdr.sh

usage() {
  echo "Verwendung: $0 [--agent claude|pi] [--model provider/id] <ticket> [<ticket> …] [-- <Agent-Optionen>]" >&2
  echo "Beispiele:  $0 57 58 -- --effort xhigh" >&2
  echo "            $0 --agent pi 57 58 [-- --thinking high] (Standardmodell: openai-codex/gpt-6-sol)" >&2
  exit 2
}

repo=Yggras/abnehm-app

agent=claude
model=
tickets=
while [ "$#" -gt 0 ]; do
  case "$1" in
    --) shift; break ;;
    --agent)
      [ "$#" -ge 2 ] || usage
      agent=$2; shift 2 ;;
    --model)
      [ "$#" -ge 2 ] && [ -n "$2" ] || usage
      model=$2; shift 2 ;;
    ''|*[!0-9]*) usage ;;
    *)
      case " $tickets " in *" $1 "*) echo "Fehler: Ticket #$1 doppelt angegeben." >&2; exit 2 ;; esac
      tickets="$tickets $1"; shift ;;
  esac
done
[ -n "$tickets" ] || usage
case "$agent" in claude|pi) ;; *) usage ;; esac
if [ "$agent" = claude ]; then
  [ -z "$model" ] || { echo "Fehler: --model ist nur mit --agent pi verfügbar." >&2; exit 2; }
else
  model=${model:-openai-codex/gpt-6-sol}
  case "$model" in */?*) ;; *) echo "Fehler: Pi-Modell als provider/id angeben." >&2; exit 2 ;; esac
fi

# Shell-sicheres Quoting für den Befehl, den Herdr in den Tab tippt.
quote() {
  printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"
}

extra_args=
for arg in "$@"; do
  extra_args="$extra_args $(quote "$arg")"
done

[ "${HERDR_ENV:-}" = 1 ] && [ -n "${HERDR_WORKSPACE_ID:-}" ] || {
  echo "Fehler: Nicht in Herdr gestartet (HERDR_ENV/HERDR_WORKSPACE_ID fehlen)." >&2
  exit 1
}
for tool in herdr gh jq "$agent"; do
  command -v "$tool" >/dev/null 2>&1 || {
    echo "Fehler: '$tool' ist nicht installiert." >&2
    exit 1
  }
done

if [ "$agent" = pi ]; then
  # Vor dem ersten Tab auch Modell und Zugang prüfen (nicht erst im gestarteten Tab).
  if ! pi --list-models "$model" | awk -v wanted="$model" 'NR > 1 && $1 "/" $2 == wanted { found = 1 } END { exit !found }'; then
    echo "Fehler: Pi-Modell '$model' nicht verfügbar (pi --list-models prüfen)." >&2
    exit 1
  fi
  if ! pi auth check --model "$model" >/dev/null; then
    echo "Fehler: Kein nutzbarer Pi-Zugang für '$model' (pi auth check --model '$model')." >&2
    exit 1
  fi
fi

primary=$(git worktree list --porcelain | sed -n 's/^worktree //p' | head -n 1)
[ -n "$primary" ] || {
  echo "Fehler: Nicht in einem Git-Repository." >&2
  exit 1
}
worktrees_dir="$(dirname "$primary")/$(basename "$primary")-worktrees"

# Erst alle Tickets prüfen, dann starten: entweder alle Tabs oder keiner.
problems=
for ticket in $tickets; do
  info=$(gh api "repos/$repo/issues/$ticket" \
    --jq '[.state, (.assignees | length), (.issue_dependencies_summary.blocked_by // 0),
      ([.labels[].name] | index("wayfinder:map") != null)] | @tsv') || {
    problems="$problems\n  #$ticket: nicht abrufbar"
    continue
  }
  state=$(printf '%s' "$info" | cut -f1)
  assignees=$(printf '%s' "$info" | cut -f2)
  blocked=$(printf '%s' "$info" | cut -f3)
  is_map=$(printf '%s' "$info" | cut -f4)
  [ "$is_map" = false ] || problems="$problems\n  #$ticket: ist die Karte selbst, kein Ticket"
  [ "$state" = open ] || problems="$problems\n  #$ticket: nicht offen ($state)"
  [ "$assignees" = 0 ] || problems="$problems\n  #$ticket: bereits zugewiesen (von einer anderen Session belegt)"
  [ "$blocked" = 0 ] || problems="$problems\n  #$ticket: noch durch $blocked offene(s) Ticket(s) blockiert"
  if git -C "$primary" for-each-ref --format='%(refname)' "refs/heads/work/$ticket-*" | grep -q . \
    || ls -d "$worktrees_dir/$ticket-"* >/dev/null 2>&1; then
    problems="$problems\n  #$ticket: hat bereits einen Branch oder Worktree"
  fi
done
if [ -n "$problems" ]; then
  printf 'Abgebrochen, kein Tab gestartet:%b\n' "$problems" >&2
  exit 1
fi

for ticket in $tickets; do
  title=$(gh issue view "$ticket" --repo "$repo" --json title --jq .title)
  short=$(printf '%s' "$title" | sed 's/^Spezifikation erstellen: //')
  label="#$ticket $short"

  created=$(herdr tab create --workspace "$HERDR_WORKSPACE_ID" --cwd "$primary" \
    --label "$label" --no-focus)
  tab=$(printf '%s' "$created" | jq -r '.result.tab.tab_id // empty')
  pane=$(printf '%s' "$created" | jq -r '.result.root_pane.pane_id // empty')
  [ -n "$tab" ] && [ -n "$pane" ] || {
    echo "Fehler: Herdr lieferte keine Tab-/Pane-ID für #$ticket: $created" >&2
    exit 1
  }

  if [ "$agent" = pi ]; then
    command="pi --model $(quote "$model") --name $(quote "$label")$extra_args $(quote "/skill:start $ticket")"
  else
    command="claude --permission-mode auto -n $(quote "$label")$extra_args $(quote "/start $ticket")"
  fi
  herdr pane run "$pane" "$command" >/dev/null
  printf 'Gestartet: %s  (Tab %s)\n' "$label" "$tab"
done

#!/usr/bin/env bash
# Legt fehlende lokale Secrets für die Entwicklungsumgebung an (compose.yaml).
# Die Dateien liegen unter secrets/, sind von Git und Docker-Build-Kontext ausgeschlossen
# und gelten nur für synthetische Daten auf diesem Rechner.
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
secrets_dir="$repo_root/secrets"

mkdir -p "$secrets_dir"
chmod 700 "$secrets_dir"

ensure_secret() {
  local file="$secrets_dir/$1"
  if [[ ! -s "$file" ]]; then
    (umask 077 && openssl rand -hex 32 >"$file")
    echo "Secret angelegt: secrets/$1"
  fi
}

ensure_secret postgres_password
ensure_secret better_auth_secret

#!/bin/sh
set -eu

usage() {
  echo "Verwendung: $0 <ticketnummer> <kurzname>" >&2
  echo "Beispiel: $0 13 kalorientracker" >&2
  exit 2
}

[ "$#" -eq 2 ] || usage

ticket=$1
slug=$2
case "$ticket" in
  ''|*[!0-9]*) usage ;;
esac
case "$slug" in
  ''|*[!a-z0-9-]*) usage ;;
esac

current=$(git rev-parse --show-toplevel 2>/dev/null) || {
  echo "Fehler: Nicht in einem Git-Repository." >&2
  exit 1
}
primary=$(git worktree list --porcelain | sed -n 's/^worktree //p' | head -n 1)

if [ "$current" != "$primary" ]; then
  echo "Fehler: Dieses Skript wird nur im primären Checkout ausgeführt." >&2
  echo "Aktuell: $current" >&2
  echo "Primär:  $primary" >&2
  exit 1
fi

branch="work/$ticket-$slug"
worktrees_dir="$(dirname "$primary")/$(basename "$primary")-worktrees"
destination="$worktrees_dir/$ticket-$slug"

git fetch origin main

# Sperre pro Ticketnummer (unabhängig vom Kurznamen): Exit-Code 3 = Ticket ist
# bereits von einer anderen Session belegt, nächstes Frontier-Ticket nehmen.
taken_branches=$(git for-each-ref --format='%(refname:short)' "refs/heads/work/$ticket-*")
taken_dirs=$(ls -d "$worktrees_dir/$ticket-"* 2>/dev/null || true)
if [ -n "$taken_branches$taken_dirs" ]; then
  echo "Belegt: Ticket $ticket hat bereits einen Branch oder Worktree:" >&2
  printf '%s\n%s\n' "$taken_branches" "$taken_dirs" | sed '/^$/d; s/^/  /' >&2
  exit 3
fi

mkdir -p "$worktrees_dir"
git worktree add "$destination" -b "$branch" origin/main

printf '\nWorktree erstellt:\n  %s\nBranch:\n  %s\n\nSession jetzt in diesen Worktree verlegen und dort weiterarbeiten.\n' \
  "$destination" "$branch"

#!/usr/bin/env python3
"""Ändert den Text der Wayfinder-Karte, ohne parallele Sessions zu überschreiben.

`gh issue edit --body` ersetzt immer den ganzen Text. Damit sich parallele
Sessions nicht gegenseitig Zeilen löschen, lädt dieses Skript den Text unter
einer exklusiven Sperre frisch, ändert genau eine Zeile und schreibt ihn
zurück. Beide Befehle sind idempotent: Ist die Änderung schon da, passiert nichts.

Verwendung:
  scripts/update-map append "<Abschnitt>" "<Zeile>"
      Hängt <Zeile> ans Ende des Abschnitts "## <Abschnitt>" an,
      z. B. append "Decisions so far" "- [Titel](url) — Kurzfassung".
  scripts/update-map replace "<alte Zeile>" "<neue Zeile>"
      Ersetzt die eine Zeile, die exakt <alte Zeile> lautet.

ABNEHM_APP_MAP_ISSUE wählt ein anderes Issue als #1 (nur für Tests).
"""

import fcntl
import os
import subprocess
import sys
import time

REPO = "Yggras/abnehm-app"
LOCK_TIMEOUT_SECONDS = 120


def fail(message):
    print(f"Fehler: {message}", file=sys.stderr)
    sys.exit(1)


def run(args, stdin=None):
    result = subprocess.run(args, input=stdin, capture_output=True, text=True)
    if result.returncode != 0:
        fail(f"{' '.join(args[:3])} … schlug fehl:\n{result.stderr.strip()}")
    return result.stdout


def acquire_lock():
    common_dir = run(["git", "rev-parse", "--path-format=absolute", "--git-common-dir"]).strip()
    handle = open(os.path.join(common_dir, "abnehm-app-map.lock"), "w")
    deadline = time.monotonic() + LOCK_TIMEOUT_SECONDS
    while True:
        try:
            fcntl.flock(handle, fcntl.LOCK_EX | fcntl.LOCK_NB)
            return handle
        except BlockingIOError:
            if time.monotonic() > deadline:
                fail(f"Kartensperre nach {LOCK_TIMEOUT_SECONDS} s nicht frei.")
            time.sleep(0.5)


def append(lines, section, new_line):
    heading = f"## {section}"
    try:
        start = next(i for i, line in enumerate(lines) if line.rstrip() == heading)
    except StopIteration:
        fail(f'Abschnitt "{heading}" nicht gefunden.')
    end = next((i for i in range(start + 1, len(lines)) if lines[i].startswith("## ")), len(lines))
    if any(line.rstrip() == new_line for line in lines[start + 1:end]):
        return lines
    last = max((i for i in range(start, end) if lines[i].strip()), default=start)
    return lines[:last + 1] + [new_line] + lines[last + 1:]


def replace(lines, old_line, new_line):
    matches = [i for i, line in enumerate(lines) if line.rstrip() == old_line]
    if not matches and any(line.rstrip() == new_line for line in lines):
        return lines
    if len(matches) != 1:
        fail(f"Alte Zeile {len(matches)}-mal statt genau einmal gefunden: {old_line}")
    return lines[:matches[0]] + [new_line] + lines[matches[0] + 1:]


def main():
    if len(sys.argv) != 4 or sys.argv[1] not in ("append", "replace"):
        print(__doc__.split("Verwendung:")[1], file=sys.stderr)
        sys.exit(2)
    command, first, second = sys.argv[1], sys.argv[2], sys.argv[3].rstrip()
    if "\n" in second:
        fail("Die neue Zeile darf keinen Zeilenumbruch enthalten.")
    issue = os.environ.get("ABNEHM_APP_MAP_ISSUE", "1")

    lock = acquire_lock()
    try:
        body = run(["gh", "issue", "view", issue, "--repo", REPO, "--json", "body", "--jq", ".body"])
        body = body[:-1] if body.endswith("\n") else body  # --jq hängt einen Zeilenumbruch an
        lines = body.split("\n")
        if command == "append":
            updated = append(lines, first, second)
        else:
            updated = replace(lines, first.rstrip(), second)
        if updated == lines:
            print(f"Karte #{issue}: schon aktuell, nichts geändert.")
            return
        run(["gh", "issue", "edit", issue, "--repo", REPO, "--body-file", "-"], stdin="\n".join(updated))
        print(f"Karte #{issue} aktualisiert.")
    finally:
        lock.close()


if __name__ == "__main__":
    main()

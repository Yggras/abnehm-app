#!/usr/bin/env bash
# Baut ein Release-Binary der App: den E2E-Build mit Testfähigkeiten (#114) oder den Produktionsbuild (#115).
#   scripts/app-build e2e ios                       # iOS-Simulator, Backend http://localhost:8788
#   scripts/app-build e2e ios --geraet --api-url http://192.168.178.20:8788
#   scripts/app-build e2e android [--geraet]        # Emulator (10.0.2.2) bzw. echtes Gerät (adb reverse)
#   scripts/app-build e2e android --geraet --pfad   # nur den Pfad der artefakt.json nennen, nicht bauen
#   scripts/app-build produktion ios --api-url https://<maschine>.<tailnet>.ts.net
#   scripts/app-build produktion android --api-url https://<maschine>.<tailnet>.ts.net
#
# Ergebnis unter apps/mobile/build/<variante>/<ziel>/ samt artefakt.json (Artefakt-ID = SHA-256 des Binarys,
# Commit, Backend-Adresse). `expo prebuild --clean` erzeugt ios/ bzw. android/ für die Variante neu;
# ein Development Build braucht danach wieder `npm run ios` bzw. `npm run android`.
#
# Der Produktionsbuild ist immer für echte Geräte, verlangt eine https-Adresse und bricht ab, wenn das
# fertige Binary eine Ausnahme für unverschlüsselten Verkehr enthält (ATS bzw. Android-Manifest).
set -euo pipefail

# shellcheck source=prod-umgebung
source "$(dirname "${BASH_SOURCE[0]}")/prod-umgebung"
repo_root="$prod_repo_root"
mobile="$repo_root/apps/mobile"

usage() {
  sed -n '2,12p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//' >&2
  exit 2
}

args=("$@")
variant="${1:-}"
platform="${2:-}"
[[ "$variant" == "e2e" || "$variant" == "produktion" ]] || usage
[[ "$platform" == "ios" || "$platform" == "android" ]] || usage
shift 2
device=false
api_url=""
only_path=false
while [[ $# -gt 0 ]]; do
  case "$1" in
    --geraet) device=true ;;
    --pfad) only_path=true ;;
    --api-url) api_url="${2:?--api-url braucht eine Adresse}"; shift ;;
    *) usage ;;
  esac
  shift
done

if [[ "$variant" == "produktion" ]]; then
  device=true
  [[ "$api_url" =~ ^https://[^/]+$ ]] || { echo "Der Produktionsbuild braucht --api-url https://<host> ohne Pfad." >&2; exit 2; }
fi

port="${E2E_BACKEND_PORT:-8788}"
if [[ -z "$api_url" ]]; then
  case "$platform:$device" in
    ios:true)
      echo "Ein echtes iPhone erreicht localhost des Rechners nicht: --api-url http://<LAN-IP>:$port angeben." >&2
      exit 2 ;;
    # Der iOS-Simulator teilt das Netz des Rechners.
    ios:false) api_url="http://localhost:$port" ;;
    # Der Emulator erreicht den Rechner über 10.0.2.2 (https://developer.android.com/studio/run/emulator-networking-address);
    # anders als `adb reverse` trennt der Flugmodus diesen Weg (im Emulator beobachtet am 21.10.2026).
    android:false) api_url="http://10.0.2.2:$port" ;;
    # Ein echtes Gerät per Kabel über `adb reverse` (scripts/e2e-run). Im Emulator überstand dieser Weg den
    # Flugmodus (beobachtet am 21.10.2026); für sync-offline auf einem echten Gerät deshalb --api-url mit
    # der LAN-Adresse.
    android:true) api_url="http://localhost:$port" ;;
  esac
fi

target="$platform-$([[ "$device" == true ]] && echo geraet || ([[ "$platform" == ios ]] && echo simulator || echo emulator))"
out="$mobile/build/$variant/$target"
if [[ "$only_path" == true ]]; then echo "$out/artefakt.json"; exit 0; fi
# Gerätesperre (#282): Der Build läuft unter scripts/geraete-slot, außer ein Aufrufer (e2e-run) hält sie schon.
if [[ -z "${ABNEHM_GERAETE_SLOT:-}" ]]; then
  cd "$repo_root" && exec scripts/geraete-slot mit -- "$repo_root/scripts/app-build" ${args[@]+"${args[@]}"}
fi
rm -rf "$out"
mkdir -p "$out"

if [[ "$variant" == "e2e" ]]; then
  # Variante und Bündel-Schalter gehören zusammen; app.config.ts prüft das (src/build-capabilities.ts).
  export APP_VARIANT=e2e
  export EXPO_PUBLIC_E2E_BUILD=true
  scheme_name="abnehmapp-e2e"
  apk_name="abnehm-app-e2e.apk"
else
  export APP_VARIANT=production
  unset EXPO_PUBLIC_E2E_BUILD
  scheme_name="abnehmapp"
  apk_name="abnehm-app.apk"
fi
export EXPO_PUBLIC_API_URL="$api_url"
export NODE_ENV=production

cd "$mobile"
echo "Erzeuge den nativen $platform-Ordner für die Variante $APP_VARIANT …" >&2
npx expo prebuild --clean --platform "$platform" >&2

if [[ "$platform" == "ios" ]]; then
  workspace="$(ls -d ios/*.xcworkspace | head -n 1)"
  scheme="$(basename "$workspace" .xcworkspace)"
  if [[ "$device" == true ]]; then
    team="${APPLE_TEAM_ID:-$(security find-certificate -c "Apple Development" -p 2>/dev/null | openssl x509 -noout -subject 2>/dev/null | sed -n 's/.*OU=\([A-Z0-9]*\).*/\1/p')}"
    [[ -n "$team" ]] || { echo "Kein Signierteam gefunden; APPLE_TEAM_ID setzen." >&2; exit 1; }
    sdk=(-sdk iphoneos -destination 'generic/platform=iOS' -allowProvisioningUpdates DEVELOPMENT_TEAM="$team")
    products="Release-iphoneos"
  else
    sdk=(-sdk iphonesimulator -destination 'generic/platform=iOS Simulator')
    products="Release-iphonesimulator"
  fi
  echo "Baue $scheme (Release) …" >&2
  xcodebuild -workspace "$workspace" -scheme "$scheme" -configuration Release "${sdk[@]}" \
    -derivedDataPath "$out/derived" build -quiet >&2
  app="$(ls -d "$out/derived/Build/Products/$products/"*.app | head -n 1)"
  mv "$app" "$out/"
  rm -rf "$out/derived"
  binary="$out/$(basename "$app")"
  artifact_id="$(artifact_id_of "$binary")"
  app_id="$(/usr/libexec/PlistBuddy -c 'Print :CFBundleIdentifier' "$binary/Info.plist")"
else
  echo "Baue die Release-APK …" >&2
  # Ohne Daemon, damit der Build sicher in der Umgebung dieses Aufrufs bündelt (Variante, Schalter, Backend).
  gradle_args=(--no-daemon --quiet)
  # Der Emulator `medium_phone` ist arm64-v8a (abi.type in der config.ini des AVD). Nur diese ABI zu bauen spart
  # den Großteil der nativen Build-Zeit (https://reactnative.dev/docs/build-speed); Gerät und Produktion bauen alle.
  [[ "$device" == true ]] || gradle_args+=(-PreactNativeArchitectures=arm64-v8a)
  (cd android && ./gradlew "${gradle_args[@]}" :app:assembleRelease >&2)
  mv android/app/build/outputs/apk/release/app-release.apk "$out/$apk_name"
  binary="$out/$apk_name"
  artifact_id="$(artifact_id_of "$binary")"
  app_id="$([[ "$variant" == e2e ]] && echo de.yggras.abnehmapp.e2e || echo de.yggras.abnehmapp)"
fi

if [[ "$variant" == "produktion" ]]; then
  "$repo_root/scripts/app-artefakt-pruefen" "$binary" "$api_url" >&2
fi

commit="$(cd "$repo_root" && git rev-parse HEAD)"
dirty="$(cd "$repo_root" && [[ -z "$(git status --porcelain)" ]] && echo false || echo true)"
version="$(node -p "require('./package.json').version")"
cat > "$out/artefakt.json" <<JSON
{
  "ziel": "$target",
  "variante": "$variant",
  "appId": "$app_id",
  "schema": "$scheme_name",
  "binary": "$(basename "$binary")",
  "artefaktId": "sha256:$artifact_id",
  "version": "$version",
  "commit": "$commit",
  "ungespeicherteAenderungen": $dirty,
  "backend": "$api_url",
  "gebautUm": "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
}
JSON
echo "$out/artefakt.json"
cat "$out/artefakt.json" >&2

#!/usr/bin/env bash
# Gerätesperre (#282): Simulatoren, Emulatoren und App-Builds nutzt auf diesem Rechner immer nur eine Session.
#   scripts/geraete-slot nehmen              # nehmen oder erneuern; Exit 3 = von einer anderen Session belegt
#   scripts/geraete-slot nehmen --warten     # warten, bis die Sperre frei ist
#   scripts/geraete-slot freigeben           # Geräte herunterfahren, E2E-Backend entfernen, Sperre lösen
#   scripts/geraete-slot freigeben --erzwingen   # nur nach Rücksprache: Sperre einer anderen Session lösen
#   scripts/geraete-slot status
#
# Inhaber ist der Worktree des Aufrufs. `nehmen` gibt auf stdout `genommen` oder `erneuert` aus. Eine Sperre
# verfällt, wenn ihr Worktree fehlt oder sie ABNEHM_GERAETE_SLOT_MINUTEN (60) lang nicht erneuert wurde.
# Wer die Sperre neu nimmt oder freigibt, fährt alle Simulatoren und Emulatoren herunter und entfernt den
# E2E-Stack samt Volumes (nur synthetische Seed-Daten): Jeder Worktree hat eigene Secrets, ein Postgres-Volume
# eines anderen Worktrees ließe das E2E-Backend an der Anmeldung scheitern.
set -euo pipefail

usage() {
  sed -n '2,13p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//' >&2
  exit 2
}

me="$(git rev-parse --show-toplevel 2>/dev/null)" || { echo "Fehler: Nicht in einem Git-Repository." >&2; exit 1; }
common_dir="$(git rev-parse --path-format=absolute --git-common-dir)"
state="$common_dir/abnehm-app-geraete-slot"
lockfile="$common_dir/abnehm-app-geraete-slot.lock"
lease_seconds=$(( ${ABNEHM_GERAETE_SLOT_MINUTEN:-60} * 60 ))

# Lesen und Schreiben des Zustands laufen unter einer Dateisperre wie in scripts/start-ticket-worktree.
locked() {
  if command -v lockf >/dev/null 2>&1; then lockf -k -t 300 "$lockfile" "$0" "$@"
  elif command -v flock >/dev/null 2>&1; then flock -w 300 "$lockfile" "$0" "$@"
  else echo "Fehler: Weder lockf noch flock gefunden; die Gerätesperre wäre ungeschützt." >&2; exit 1; fi
}

field() { [[ -f "$state" ]] && sed -n "s/^$1=//p" "$state" || true; }
holder="$(field inhaber)"
since="$(field seit)"
renewed="$(field erneuert)"
now="$(date +%s)"

describe() {
  echo "$holder (seit $(( (now - since) / 60 )) min, zuletzt erneuert vor $(( (now - renewed) / 60 )) min)"
}

orphan_reason() {
  if [[ ! -d "$holder" ]]; then echo "Worktree fehlt"
  elif (( now - renewed >= lease_seconds )); then echo "seit $(( (now - renewed) / 60 )) min nicht erneuert"; fi
}

write_state() {
  printf 'inhaber=%s\nseit=%s\nerneuert=%s\n' "$me" "$1" "$now" >"$state.tmp"
  mv "$state.tmp" "$state"
}

adb_bin() {
  if command -v adb >/dev/null; then command -v adb; else echo "${ANDROID_HOME:-$HOME/Library/Android/sdk}/platform-tools/adb"; fi
}

clean_up_devices() {
  echo "Gerätesperre: fahre Simulatoren und Emulatoren herunter, entferne das E2E-Backend …" >&2
  xcrun simctl shutdown all >&2 || echo "Warnung: Simulatoren nicht heruntergefahren." >&2
  local adb serial
  adb="$(adb_bin)"
  if [[ -x "$adb" ]]; then
    # https://developer.android.com/studio/run/emulator-console › „Fire-and-forget commands“
    for serial in $("$adb" devices | awk 'NR > 1 && $1 ~ /^emulator-/ { print $1 }'); do
      "$adb" -s "$serial" emu kill >&2 || echo "Warnung: Emulator $serial nicht beendet." >&2
    done
  fi
  (cd "$me" && docker compose --project-name "${E2E_COMPOSE_PROJECT:-abnehm-e2e}" down --volumes --remove-orphans >&2) \
    || echo "Warnung: E2E-Backend nicht entfernt (läuft Docker?)." >&2
}

case "${1:-}" in
  __nehmen)
    if [[ "$holder" == "$me" ]]; then
      write_state "$since"
      echo erneuert
      exit 0
    fi
    if [[ -n "$holder" ]]; then
      reason="$(orphan_reason)"
      if [[ -z "$reason" ]]; then
        echo "Gerätesperre belegt: $(describe)" >&2
        exit 3
      fi
      echo "Gerätesperre von $holder ist verwaist ($reason); übernehme sie." >&2
    fi
    clean_up_devices
    write_state "$now"
    echo genommen
    ;;
  __freigeben)
    if [[ -z "$holder" ]]; then
      echo "Gerätesperre ist frei." >&2
      exit 0
    fi
    if [[ "$holder" != "$me" && "${2:-}" != --erzwingen ]]; then
      echo "Fehler: Die Gerätesperre hält $(describe)." >&2
      exit 1
    fi
    clean_up_devices
    rm -f "$state"
    echo "Gerätesperre freigegeben." >&2
    ;;
  nehmen)
    case "${2:-}" in
      "") locked __nehmen ;;
      --warten)
        waited=false
        messages="$(mktemp)"
        trap 'rm -f "$messages"' EXIT
        while true; do
          status=0
          result="$(locked __nehmen 2>"$messages")" || status=$?
          if [[ "$status" == 0 ]]; then cat "$messages" >&2; echo "$result"; exit 0; fi
          [[ "$status" == 3 ]] || { cat "$messages" >&2; exit "$status"; }
          if [[ "$waited" == false ]]; then
            cat "$messages" >&2
            echo "Warte auf die Gerätesperre …" >&2
            waited=true
          fi
          sleep "${ABNEHM_GERAETE_SLOT_INTERVALL:-20}"
        done
        ;;
      *) usage ;;
    esac
    ;;
  freigeben)
    [[ -z "${2:-}" || "${2:-}" == --erzwingen ]] || usage
    locked __freigeben "${2:-}"
    ;;
  status)
    if [[ -z "$holder" ]]; then echo "frei"
    else
      reason="$(orphan_reason)"
      echo "belegt: $(describe)${reason:+ – verwaist: $reason}"
    fi
    ;;
  *) usage ;;
esac

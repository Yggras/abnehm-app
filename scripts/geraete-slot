#!/usr/bin/env bash
# Gerätesperre (#282, pro Befehl seit #298): Simulatoren, Emulatoren und App-Builds nutzt auf diesem Rechner immer nur eine Session.
#   scripts/geraete-slot mit -- <befehl> [argumente …]   # wartet auf die Sperre, führt den Befehl aus, gibt frei
#   scripts/geraete-slot status
#   scripts/geraete-slot freigeben --erzwingen            # nur nach Rücksprache: Sperre einer anderen Session lösen
#
# Die Sperre gilt nur, solange der Befehl läuft: Inhaber ist der Prozess von `mit`. Endet er, auch durch einen
# Absturz, ist die Sperre frei. Befehle darin, die selbst `mit` nutzen (scripts/app-build in scripts/e2e-run),
# erkennen die Sperre an ABNEHM_GERAETE_SLOT und laufen ohne neues Nehmen. Danach hat derselbe Worktree eine
# Nachfrist von ABNEHM_GERAETE_SLOT_NACHFRIST_SEKUNDEN (300) Vorrang, damit Folgeschritte wie Bildschirmfotos
# seine Geräte noch vorfinden; jeder weitere Befehl beginnt sie neu.
# Freigeben lässt Simulatoren und Emulatoren laufen. Erst wenn ein anderer Worktree die Sperre nimmt, fährt
# `mit` alle herunter und entfernt den E2E-Stack samt Volumes (nur synthetische Seed-Daten): Jeder Worktree hat
# eigene Secrets, ein Postgres-Volume eines anderen Worktrees ließe das E2E-Backend an der Anmeldung scheitern.
set -euo pipefail

usage() {
  sed -n '2,15p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//' >&2
  exit 2
}

me="$(git rev-parse --show-toplevel 2>/dev/null)" || { echo "Fehler: Nicht in einem Git-Repository." >&2; exit 1; }
common_dir="$(git rev-parse --path-format=absolute --git-common-dir)"
state="$common_dir/abnehm-app-geraete-slot"
lockfile="$common_dir/abnehm-app-geraete-slot.lock"
grace_seconds="${ABNEHM_GERAETE_SLOT_NACHFRIST_SEKUNDEN:-300}"
# Nur für Sperren der Vorgängerversion ohne Prozess (Inhaber = Worktree, Frist 60 Minuten).
legacy_lease_seconds=$(( ${ABNEHM_GERAETE_SLOT_MINUTEN:-60} * 60 ))

# Lesen und Schreiben des Zustands laufen unter einer Dateisperre wie in scripts/start-ticket-worktree.
locked() {
  if command -v lockf >/dev/null 2>&1; then lockf -k -t 300 "$lockfile" "$0" "$@"
  elif command -v flock >/dev/null 2>&1; then flock -w 300 "$lockfile" "$0" "$@"
  else echo "Fehler: Weder lockf noch flock gefunden; die Gerätesperre wäre ungeschützt." >&2; exit 1; fi
}

field() { [[ -f "$state" ]] && sed -n "s/^$1=//p" "$state" || true; }
holder="$(field inhaber)"
pid="$(field pid)"
started="$(field start)"
since="$(field seit)"
renewed="$(field erneuert)"
last="$(field zuletzt)"
free_from="$(field frei_ab)"
now="$(date +%s)"

# Startzeit eines Prozesses; schützt davor, eine wiederverwendete PID für den Inhaber zu halten.
start_of() { ps -o lstart= -p "$1" 2>/dev/null | sed 's/^ *//' || true; }

describe() {
  if [[ -n "$pid" ]]; then echo "$holder (PID $pid, seit $(( (now - ${since:-$now}) / 60 )) min: $(field befehl))"
  else echo "$holder (Vorgängerversion, seit $(( (now - ${since:-$now}) / 60 )) min, zuletzt erneuert vor $(( (now - ${renewed:-$now}) / 60 )) min)"; fi
}

orphan_reason() {
  if [[ -n "$pid" ]]; then
    local current
    current="$(start_of "$pid")"
    [[ -n "$current" && "$current" == "$started" ]] || echo "Prozess $pid beendet"
  elif [[ ! -d "$holder" ]]; then echo "Worktree fehlt"
  elif (( now - ${renewed:-0} >= legacy_lease_seconds )); then echo "seit $(( (now - ${renewed:-0}) / 60 )) min nicht erneuert"
  fi
}

# Läuft die Nachfrist des letzten Inhabers für diesen Worktree noch, die Restsekunden; sonst nichts.
grace_left() {
  [[ -n "$last" && "$last" != "$me" && -d "$last" ]] || return 0
  (( ${free_from:-0} > now )) && echo $(( free_from - now )) || true
}

adb_bin() {
  if command -v adb >/dev/null; then command -v adb; else echo "${ANDROID_HOME:-$HOME/Library/Android/sdk}/platform-tools/adb"; fi
}

clean_up_devices() {
  echo "Gerätesperre: fahre Simulatoren und Emulatoren herunter, entferne das E2E-Backend …" >&2
  xcrun simctl shutdown all >&2 || echo "Warnung: Simulatoren nicht heruntergefahren." >&2
  local adb serial
  adb="$(adb_bin)"
  if [[ -x "$adb" ]]; then
    # https://developer.android.com/studio/run/emulator-console › „Fire-and-forget commands“
    for serial in $("$adb" devices | awk 'NR > 1 && $1 ~ /^emulator-/ { print $1 }'); do
      "$adb" -s "$serial" emu kill >&2 || echo "Warnung: Emulator $serial nicht beendet." >&2
    done
  fi
  (cd "$me" && docker compose --project-name "${E2E_COMPOSE_PROJECT:-abnehm-e2e}" down --volumes --remove-orphans >&2) \
    || echo "Warnung: E2E-Backend nicht entfernt (läuft Docker?)." >&2
}

case "${1:-}" in
  __nehmen)  # __nehmen <pid> <token> <befehl>; Exit 3 = belegt
    if [[ -n "$holder" ]]; then
      reason="$(orphan_reason)"
      if [[ -z "$reason" ]]; then
        echo "Gerätesperre belegt: $(describe)" >&2
        exit 3
      fi
      echo "Gerätesperre von $holder ist verwaist ($reason); übernehme sie." >&2
    else
      left="$(grace_left)"
      if [[ -n "$left" ]]; then
        echo "Gerätesperre: Nachfrist von $last läuft noch $left s." >&2
        exit 3
      fi
    fi
    previous="${holder:-$last}"
    if [[ "$previous" != "$me" ]]; then
      [[ -z "$previous" ]] || echo "Gerätesperre: Zuletzt nutzte $previous die Geräte; die App muss neu installiert werden." >&2
      clean_up_devices
    fi
    # `erneuert` hält ältere Fassungen dieses Skripts in nicht aktualisierten Worktrees fern.
    printf 'inhaber=%s\npid=%s\nstart=%s\ntoken=%s\nseit=%s\nerneuert=%s\nbefehl=%s\n' \
      "$me" "$2" "$(start_of "$2")" "$3" "$now" "$now" "$4" >"$state.tmp"
    mv "$state.tmp" "$state"
    ;;
  __freigeben)  # __freigeben <token>: nur die eigene Sperre; die Geräte laufen weiter, die Nachfrist beginnt
    if [[ -n "$holder" && "$(field token)" == "$2" ]]; then
      printf 'zuletzt=%s\nfrei_ab=%s\n' "$me" "$(( now + grace_seconds ))" >"$state.tmp"
      mv "$state.tmp" "$state"
    fi
    ;;
  __erzwingen)
    if [[ -z "$holder" ]]; then echo "Gerätesperre ist frei." >&2; exit 0; fi
    printf 'zuletzt=%s\n' "$holder" >"$state.tmp"
    mv "$state.tmp" "$state"
    echo "Gerätesperre von $holder gelöst." >&2
    ;;
  mit)
    shift
    [[ "${1:-}" == -- ]] && shift
    [[ $# -gt 0 ]] || usage
    # Ein umschließender Befehl hält die Sperre schon.
    if [[ -n "${ABNEHM_GERAETE_SLOT:-}" && "$ABNEHM_GERAETE_SLOT" == "$(field token)" && -z "$(orphan_reason)" ]]; then
      exec "$@"
    fi
    token="$$-$now-$RANDOM"
    command_line="$(printf '%s ' "$@" | tr '\n' ' ' | cut -c1-160)"
    messages="$(mktemp)"
    trap 'rm -f "$messages"' EXIT
    waited=false
    while true; do
      status=0
      locked __nehmen "$$" "$token" "$command_line" 2>"$messages" || status=$?
      [[ "$status" == 0 ]] && break
      [[ "$status" == 3 ]] || { cat "$messages" >&2; rm -f "$messages"; exit "$status"; }
      if [[ "$waited" == false ]]; then
        cat "$messages" >&2
        echo "Warte auf die Gerätesperre …" >&2
        waited=true
      fi
      sleep "${ABNEHM_GERAETE_SLOT_INTERVALL:-20}"
    done
    cat "$messages" >&2
    rm -f "$messages"
    trap 'locked __freigeben "$token"' EXIT
    trap 'exit 130' INT
    trap 'exit 143' TERM
    export ABNEHM_GERAETE_SLOT="$token"
    status=0
    "$@" || status=$?
    exit "$status"
    ;;
  freigeben)
    [[ "${2:-}" == --erzwingen ]] || usage
    locked __erzwingen
    ;;
  nehmen)
    echo "Fehler: \`nehmen\` gibt es nicht mehr; Gerätebefehle laufen mit \`scripts/geraete-slot mit -- <befehl>\`." >&2
    exit 2
    ;;
  status)
    if [[ -z "$holder" ]]; then
      left="$(grace_left)"
      if [[ -n "$left" ]]; then echo "Nachfrist: $last hat noch $left s Vorrang"
      else echo "frei${last:+ (zuletzt: $last)}"; fi
    else
      reason="$(orphan_reason)"
      echo "belegt: $(describe)${reason:+ – verwaist: $reason}"
    fi
    ;;
  *) usage ;;
esac

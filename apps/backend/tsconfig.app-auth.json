{
  // Nur die Integrationstests, die App-Code importieren (App-Auth-Modul und App-Sync). App-Code arbeitet
  // wie die App mit Bundler-Auflösung und ohne Dateiendungen; unter `nodenext` gälte die Datei als
  // CommonJS. Backend-Code prüft zusätzlich tsconfig.json mit `nodenext`.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2024",
    "lib": ["ES2024"],
    "module": "preserve",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    // Wie in der App: die gebündelten SQLite-Migrationen (`migrations.js`) sind JavaScript.
    "allowJs": true,
    "resolveJsonModule": true,
    "types": ["node"]
  },
  // postgres-server.ts deklariert den von Vitest bereitgestellten Postgres-Zugang.
  "include": ["test/app-auth.test.ts", "test/sync-app.test.ts", "test/person-sync-app.test.ts", "test/online-app.test.ts", "test/seed-app.test.ts", "test/daily-goals-app.test.ts", "test/logout-app.test.ts", "test/partner-projections-app.test.ts", "test/uncoupling-app.test.ts", "test/seed-partner-app.test.ts", "test/water-sync-app.test.ts", "test/plan-sync-app.test.ts", "test/nutrition-sync-app.test.ts", "test/weight-sync-app.test.ts", "test/support/tracker-phones.ts", "test/support/postgres-server.ts", "test/account-name-app.test.ts", "test/fake-auth-backend.test.ts", "test/seed-manifeste-app.test.ts", "test/support/seed-world.ts", "test/seed-randzustaende-app.test.ts", "test/seed-sync-szenarien-app.test.ts"]
}
